# Copy this file to .env in this same directory, then fill in your own values.
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows)
#
# NEVER commit the real .env — it is listed in .gitignore.
#
# The app reads .env from EITHER this project root (recommended — it sits beside
# docker-compose.yml) or backend/.env. If both exist, this one wins.

# Get a free key from Google AI Studio: https://aistudio.google.com/apikey
# No credit card required. Do NOT enable billing on that Google Cloud project —
# doing so silently moves you off the free tier. See README.md.
GEMINI_API_KEY=your_gemini_api_key_here

# Chat model. Flash-Lite has the most generous free-tier limits.
#   gemini-3.5-flash-lite     verified working (recommended)
#   gemini-flash-lite-latest  floating alias, always points at a current Flash-Lite
#   gemini-3.1-flash-lite     also works
# WARNING: gemini-2.5-flash-lite is retired for NEW API keys — it still shows up in
# the model list but returns 404 "no longer available to new users".
GEMINI_MODEL=gemini-3.5-flash-lite

# Embedding model, used for RAG retrieval and the semantic cache.
EMBED_MODEL=gemini-embedding-001

# --- Optional tuning (sensible defaults are built in; uncomment to override) ---
# DATA_DIR=./data
# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
# RAG_TOP_K=4
# CACHE_SIMILARITY_THRESHOLD=0.92
